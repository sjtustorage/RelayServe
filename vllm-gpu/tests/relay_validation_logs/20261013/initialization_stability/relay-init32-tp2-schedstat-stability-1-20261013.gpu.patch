+def _thread_runqueue_wait_seconds() -> Optional[float]:
+    """Linux scheduler delay, distinct from time blocked on native work."""
+    if not os.environ.get("VLLM_PROFILE_RELAY"):
+        return None
+    try:
+        with open("/proc/thread-self/schedstat") as stats:
+            return int(stats.read().split()[1]) / 1e9
+    except (OSError, ValueError, IndexError):
+        return None
+
