+    @contextmanager
+    def warmup_layer_range(self):
+        """Warm a representative homogeneous Qwen layer, then restore relay."""
+        if self.load_config.load_format != "shm":
+            yield
+            return
+        model = self.get_model()
+        inner = getattr(model, "model", model)
+        if not hasattr(inner, "start_layer") or not hasattr(inner, "end_layer"):
+            yield
+            return
+        # Eager dense Qwen layers share kernels across weight addresses. A
+        # single layer includes both plain and fused-residual RMSNorm paths.
+        # Keep graph/compiled execution and heterogeneous models unchanged.
+        from vllm.model_executor.models.qwen2 import Qwen2Model
+        from vllm.model_executor.models.qwen3 import Qwen3Model
+        if (not self.model_config.enforce_eager
+                or type(inner) not in (Qwen2Model, Qwen3Model)
+                or getattr(inner, "quant_config", None) is not None
+                or getattr(self.model_config.hf_config, "use_sliding_window", False)
+                or getattr(self.model_config.hf_config,
+                           "dual_chunk_attention_config", None)
+                or self.speculative_config is not None):
+            yield
+            return
+        layers = {
+            extract_layer_index(name)
+            for group in self.kv_cache_config.kv_cache_groups
+            for name in group.layer_names
+        }
+        if not layers:
+            yield
+            return
+        active_range = inner.start_layer, inner.end_layer
+        inner.start_layer, inner.end_layer = min(layers), min(layers) + 1
+        try:
+            yield
+        finally:
+            inner.start_layer, inner.end_layer = active_range
+
     def _update_model_layer_range(self, start: int=-1, end: int=-1) -> None:
         """Update the inner model's start_layer/end_layer so forward() only
         runs the uniform partition (layers outside it had KV removed)."""
